<?xml version="1.0"?>
<N10X>
	<Workspace>
		<IncludeFilter>*.c,*.cc,*.cpp,*.c++,*.cp,*.cxx,*.h,*.hh,*.hpp,*.h++,*.hp,*.hxx,*.inl,*.cs,*.rs,*.java,*.jav,*.js,*.jsc,*.jsx,*.json,*.cls,*.py,*.rpy,*.php,*.php3,*.phl,*.phtml,*.rhtml,*.tpl,*.phps,*.lua,*.html,*.html5,*.htm,*.xml,*.xaml,*.css,*.ssi,*.haml,*.yaml,*.bat,*.wbf,*.wbt,*.txt,*.cmake,*.make,*.makefile,*.mak,*.mk,*.sh,*.bash,*.csv,*.asp,*.pl,*.mac,*.ws,*.vbs,*.perl,*.src,*.rss,*.inc,*.f,*.go,*.prl,*.plx,*.rb,*.lsp,*.lpx,*.ps1,*.command,*.cbl,*.cob,*.qs,*.wxs,*.ph,*.msc,*.glsl,*.hlsl,*.fx,*.vert,*.tesc,*.tese,*.geom,*.frag,*.comp,*.pssl,*.scons,*.cu,*.jai,*.toml,</IncludeFilter>
		<ExcludeFilter></ExcludeFilter>
		<SyncFiles>true</SyncFiles>
		<Recursive>true</Recursive>
		<ShowEmptyFolders>true</ShowEmptyFolders>
		<IncludeFilesWithoutExt>false</IncludeFilesWithoutExt>
		<IsFolder>false</IsFolder>
		<UseVisualStudioEnvBat>false</UseVisualStudioEnvBat>
		<CaptureExeOutput>true</CaptureExeOutput>
		<Configurations>
			<Configuration>Debug</Configuration>
			<Configuration>Release</Configuration>
		</Configurations>
		<Platforms>
			<Platform>x64</Platform>
		</Platforms>
		<AdditionalIncludePaths></AdditionalIncludePaths>
		<Defines></Defines>
		<ConfigProperties>
			<ConfigAndPlatform>
				<Name>Debug:x64</Name>
				<BuildCommand>phuild.bat zebra-crosslink $(Configuration)</BuildCommand>
				<RebuildCommand></RebuildCommand>
				<BuildFileCommand></BuildFileCommand>
				<CleanCommand></CleanCommand>
				<BuildWorkingDirectory></BuildWorkingDirectory>
				<FileSyntaxCheckCommand></FileSyntaxCheckCommand>
				<CancelBuild></CancelBuild>
				<Exe></Exe>
				<Args></Args>
				<WorkingDirectory>C:\Work\ShieldedLabs\crosslink_monolith</WorkingDirectory>
				<DebugCommand>C:\Work\ShieldedLabs\crosslink_monolith\crosslink_monolith.rdbg</DebugCommand>
				<DebuggerExe></DebuggerExe>
				<DebugSln>C:\Work\ShieldedLabs\crosslink_monolith\zebra-crosslink\zebra_crosslink.sln</DebugSln>
				<Defines></Defines>
				<ForceIncludes></ForceIncludes>
				<PrioritiseFiles></PrioritiseFiles>
			</ConfigAndPlatform>
			<ConfigAndPlatform>
				<Name>Release:x64</Name>
				<BuildCommand>C:\Work\ShieldedLabs\crosslink_monolith\remote_phuild.bat $(Configuration) </BuildCommand>
				<RebuildCommand></RebuildCommand>
				<BuildFileCommand></BuildFileCommand>
				<CleanCommand></CleanCommand>
				<BuildWorkingDirectory></BuildWorkingDirectory>
				<FileSyntaxCheckCommand></FileSyntaxCheckCommand>
				<CancelBuild></CancelBuild>
				<Exe></Exe>
				<Args></Args>
				<WorkingDirectory>C:\Work\ShieldedLabs\crosslink_monolith</WorkingDirectory>
				<DebugCommand></DebugCommand>
				<DebuggerExe></DebuggerExe>
				<DebugSln>C:\Work\ShieldedLabs\crosslink_monolith\zebra-crosslink\zebra_crosslink.sln</DebugSln>
				<Defines></Defines>
				<ForceIncludes></ForceIncludes>
				<PrioritiseFiles></PrioritiseFiles>
			</ConfigAndPlatform>
			<ConfigAndPlatform>
				<Name>debug:x64</Name>
				<BuildCommand>phuild.bat -$(Configuration)</BuildCommand>
				<RebuildCommand></RebuildCommand>
				<BuildFileCommand></BuildFileCommand>
				<CleanCommand></CleanCommand>
				<BuildWorkingDirectory></BuildWorkingDirectory>
				<FileSyntaxCheckCommand></FileSyntaxCheckCommand>
				<CancelBuild></CancelBuild>
				<Exe></Exe>
				<Args></Args>
				<WorkingDirectory>$(WorkspaceDirectory)</WorkingDirectory>
				<DebugCommand>$(Executable)</DebugCommand>
				<DebuggerExe></DebuggerExe>
				<DebugSln></DebugSln>
				<Defines></Defines>
				<ForceIncludes></ForceIncludes>
				<PrioritiseFiles></PrioritiseFiles>
			</ConfigAndPlatform>
			<ConfigAndPlatform>
				<Name>release:x64</Name>
				<BuildCommand>phuild.bat -$(Configuration)</BuildCommand>
				<RebuildCommand></RebuildCommand>
				<BuildFileCommand></BuildFileCommand>
				<CleanCommand></CleanCommand>
				<BuildWorkingDirectory></BuildWorkingDirectory>
				<FileSyntaxCheckCommand></FileSyntaxCheckCommand>
