    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'zebrad'",
            "program": "/Users/azmr/crosslink_monolith/zebra-crosslink/target/debug/zebrad",
            "sourceLanguages": ["rust"],
            "cargo": {
                "args": [
                    "build",
                    "--manifest-path=/Users/azmr/crosslink_monolith/zebra-crosslink/Cargo.toml",
                    "--bin=zebrad",
                    "--package=zebrad",
                    "-Finternal-miner,viz_gui"
                ],
                "filter": {
                    "name": "zebrad",
                    "kind": "bin"
                }
            },
            "args": ["-c", "/Users/azmr/Library/Preferences/zebrad_cl.toml"],
            "cwd": "${workspaceFolder}",
            "env": { "RUSTFLAGS": "-Awarnings" },
            "showDisassembly": false,
            "breakpoints": {
                "exception": {
                    "rust_panic": "eh",
                    "cpp_exception": "eh"
                }
            }
        }
    ]
}
