<?xml version="1.0"?>
<N10X>
	<Workspace>
		<IncludeFilter>*.c,*.cc,*.cpp,*.c++,*.cp,*.cxx,*.h,*.hh,*.hpp,*.h++,*.hp,*.hxx,*.inl,*.cs,*.rs,*.java,*.jav,*.js,*.jsc,*.jsx,*.json,*.cls,*.py,*.rpy,*.php,*.php3,*.phl,*.phtml,*.rhtml,*.tpl,*.phps,*.lua,*.html,*.html5,*.htm,*.xml,*.xaml,*.css,*.ssi,*.haml,*.yaml,*.bat,*.wbf,*.wbt,*.txt,*.cmake,*.make,*.makefile,*.mak,*.mk,*.sh,*.bash,*.csv,*.asp,*.pl,*.mac,*.ws,*.vbs,*.perl,*.src,*.rss,*.inc,*.f,*.go,*.prl,*.plx,*.rb,*.lsp,*.lpx,*.ps1,*.command,*.cbl,*.cob,*.qs,*.wxs,*.ph,*.msc,*.glsl,*.hlsl,*.fx,*.vert,*.tesc,*.tese,*.geom,*.frag,*.comp,*.pssl,*.scons,*.cu,*.jai,*.toml,</IncludeFilter>
		<ExcludeFilter></ExcludeFilter>
		<SyncFiles>true</SyncFiles>
		<Recursive>true</Recursive>
		<ShowEmptyFolders>true</ShowEmptyFolders>
		<IncludeFilesWithoutExt>false</IncludeFilesWithoutExt>
		<IsFolder>false</IsFolder>
		<UseVisualStudioEnvBat>false</UseVisualStudioEnvBat>
		<CaptureExeOutput>true</CaptureExeOutput>
		<AllowAutoErrorUnderlining>true</AllowAutoErrorUnderlining>
		<Configurations>
			<Configuration>Debug</Configuration>
			<Configuration>Release</Configuration>
		</Configurations>
		<Platforms>
			<Platform>Win64</Platform>
			<Platform>Linux</Platform>
		</Platforms>
		<AdditionalIncludePaths></AdditionalIncludePaths>
		<Defines></Defines>
		<ConfigProperties>
			<ConfigAndPlatform>
				<Name>Debug:Win64</Name>
				<BuildCommand>..\phuild.bat zebra-crosslink $(Configuration) Win64</BuildCommand>
				<RebuildCommand></RebuildCommand>
				<BuildFileCommand></BuildFileCommand>
				<CleanCommand></CleanCommand>
				<BuildWorkingDirectory>./zebra-crosslink</BuildWorkingDirectory>
				<FileSyntaxCheckCommand></FileSyntaxCheckCommand>
				<CancelBuild></CancelBuild>
				<Exe></Exe>
				<Args></Args>
				<WorkingDirectory>./zebra-crosslink</WorkingDirectory>
				<DebugCommand></DebugCommand>
				<DebuggerExe></DebuggerExe>
				<DebugSln>./zebra-crosslink/zebra-crosslink.sln</DebugSln>
				<Defines></Defines>
				<ForceIncludes></ForceIncludes>
				<PrioritiseFiles></PrioritiseFiles>
			</ConfigAndPlatform>
			<ConfigAndPlatform>
				<Name>Release:Win64</Name>
				<BuildCommand>..\phuild.bat zebra-crosslink $(Configuration) Win64</BuildCommand>
				<RebuildCommand></RebuildCommand>
				<BuildFileCommand></BuildFileCommand>
				<CleanCommand></CleanCommand>
				<BuildWorkingDirectory>./zebra-crosslink</BuildWorkingDirectory>
				<FileSyntaxCheckCommand></FileSyntaxCheckCommand>
				<CancelBuild></CancelBuild>
				<Exe></Exe>
				<Args></Args>
				<WorkingDirectory>./zebra-crosslink</WorkingDirectory>
				<DebugCommand></DebugCommand>
				<DebuggerExe></DebuggerExe>
				<DebugSln>./zebra-crosslink/zebra-crosslink.sln</DebugSln>
				<Defines></Defines>
				<ForceIncludes></ForceIncludes>
				<PrioritiseFiles></PrioritiseFiles>
			</ConfigAndPlatform>
			<ConfigAndPlatform>
				<Name>Debug:Linux</Name>
				<BuildCommand>..\phuild.bat zebra-crosslink $(Configuration) Linux</BuildCommand>
				<RebuildCommand></RebuildCommand>
				<BuildFileCommand></BuildFileCommand>
				<CleanCommand></CleanCommand>
				<BuildWorkingDirectory>./zebra-crosslink</BuildWorkingDirectory>
				<FileSyntaxCheckCommand></FileSyntaxCheckCommand>
				<CancelBuild></CancelBuild>
				<Exe></Exe>
				<Args></Args>
				<WorkingDirectory>./zebra-crosslink</WorkingDirectory>
				<DebugCommand></DebugCommand>
				<DebuggerExe></DebuggerExe>
				<DebugSln></DebugSln>
				<Defines></Defines>
				<ForceIncludes></ForceIncludes>
				<PrioritiseFiles></PrioritiseFiles>
			</ConfigAndPlatform>
			<ConfigAndPlatform>
				<Name>Release:Linux</Name>
				<BuildCommand>..\phuild.bat zebra-crosslink $(Configuration) Linux</BuildCommand>
				<RebuildCommand></RebuildCommand>
				<BuildFileCommand></BuildFileCommand>
				<CleanCommand></CleanCommand>
				<BuildWorkingDirectory>./zebra-crosslink</BuildWorkingDirectory>
				<FileSyntaxCheckCommand></FileSyntaxCheckCommand>
				<CancelBuild></CancelBuild>
				<Exe></Exe>
				<Args></Args>
				<WorkingDirectory>./zebra-crosslink</WorkingDirectory>
				<DebugCommand></DebugCommand>
				<DebuggerExe></DebuggerExe>
				<DebugSln></DebugSln>
				<Defines></Defines>
				<ForceIncludes></ForceIncludes>
				<PrioritiseFiles></PrioritiseFiles>
			</ConfigAndPlatform>
			<Config>
				<Name>Debug</Name>
				<Defines></Defines>
			</Config>
			<Config>
				<Name>Release</Name>
				<Defines></Defines>
			</Config>
			<Platform>
				<Name>Win64</Name>
				<Defines></Defines>
			</Platform>
			<Platform>
				<Name>Linux</Name>
				<Defines></Defines>
			</Platform>
		</ConfigProperties>
		<TerminalDirectory></TerminalDirectory>
		<Children></Children>
	</Workspace>
</N10X>
